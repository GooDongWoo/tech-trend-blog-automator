# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Required for group chats; private chats default to the chat's own user ID.
TELEGRAM_REVIEWER_USER_ID=
SCHEDULE_TIME=08:30
# Default: review bundles and approvals are visible, publication is blocked.
EDITORIAL_SHADOW_MODE=true
# A separately authorized cutover also requires a passing real human gate report.
EDITORIAL_CUTOVER_AUTHORIZED=false
EDITORIAL_QUALITY_GATE_REPORT=

# LLM Settings (choose models available to your account)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_STAGE_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
# JSON list of explicit provider:model fallbacks; no automatic model chain.
LLM_FALLBACK_MODELS=[]
OPENAI_API_KEY=

# Local Paths & Blog Settings
OBSIDIAN_VAULT_PATH=C:/path/to/your/ObsidianVault
BLOG_REPO_PATH=C:/path/to/your/github.io/repo
BLOG_BASE_URL=https://yourusername.github.io

# Local Qdrant RAG Service URL (Optional)
QDRANT_RAG_URL=http://localhost:8765
